{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/session_start.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/session_logger.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/dead_rules_audit.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/standup_autopilot.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/bounty_board.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/context_flags.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/recap_archive.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/instructions_audit.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/session_logger.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/dead_end_registry.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pipeline_trace.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/require_active_task.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/dead_end_registry.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pre_commit_check.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/backlog_commit_scope.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/require_draft_first.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/dedup_drift_guard.py",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pre_push_check.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pre_push_coverage_check.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/block_dangerous_commands.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pre_git_safety_check.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/case_insensitive_guard.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pr_provenance_stamp.py",
            "if": "Bash(gh pr create*)"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/protect_secrets.py"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/protect_tests.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/config_guard.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/instructions_audit.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/session_logger.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/nerf_receipts.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pipeline_trace.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/auto_stage.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/dead_rules_audit.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/bounty_board.py"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/context_hogs.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/nerf_receipts.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/block_stop_if_dirty.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/reserved_tag_guard.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/nerf_receipts.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/standup_autopilot.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/context_flags.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pipeline_trace.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/session_logger.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/dead_rules_audit.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/standup_autopilot.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/recap_archive.py"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings|policy_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/config_watch.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/pre_compact_backup.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/context_flags.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/permission_auto_allow.py"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/interlock/instructions_audit.py"
          }
        ]
      }
    ]
  }
}
